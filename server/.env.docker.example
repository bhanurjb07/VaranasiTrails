# Copy to .env.docker (next to docker-compose.yml). Local-only values: never reuse them anywhere real.
# PORT and DATABASE_URL are set by docker-compose.yml (SQLite file in a Docker volume).

# "development" prints OTP emails to the log instead of sending them.
NODE_ENV=development
TRUST_PROXY_HOPS=1

# Every origin that may call the API with cookies (vite dev servers + the root docker setup).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081
COOKIE_SAMESITE=lax

# At least 32 characters each.
JWT_SECRET=local-docker-jwt-secret-change-me-0123456789
OTP_SECRET=local-docker-otp-secret-change-me-0123456789

# Left empty on purpose: OTP codes appear in `docker compose logs -f server`.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Placeholders let the API start. Photo uploads need a real Cloudflare R2 bucket.
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
R2_BUCKET=local
R2_PUBLIC_BASE_URL=https://media.example.com

# Load the sample categories and trips on start (safe to repeat).
SEED_ON_START=true

# Admin created on start. Password: 10+ characters, upper and lower case, a number.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=LocalAdminPass1
ADMIN_NAME=Site Admin
