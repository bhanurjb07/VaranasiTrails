# Copy to .env and fill in. No real secrets in this file.

# ----- Server -----
# Defaults to "production" when unset. Use "development" locally: OTP emails are
# then printed to the console when BREVO_API_KEY is missing.
NODE_ENV=development
PORT=5001
# How many reverse proxies sit in front of this server. 1 = the host only (Render, Railway,
# Fly...). Use 2 when Cloudflare proxies the API in front of the host. Wrong values break
# client IPs and rate limiting.
TRUST_PROXY_HOPS=1
# Comma separated list of every origin that may call the API with cookies: the public
# site AND the admin panel. Example: https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ----- Refresh cookie (app. / admin. / api. on one parent domain) -----
# Share the cookie across subdomains, e.g. ".example.com". Leave empty for localhost.
# COOKIE_DOMAIN=.example.com
# "lax" works when every site is on the same registrable domain. Use "none" only for
# different domains (it forces the Secure flag).
COOKIE_SAMESITE=lax

# ----- Database (Turso / libSQL) -----
# Local development: a SQLite file next to package.json.
DATABASE_URL=file:./dev.db
# Production: set these instead (the Turso values win when present).
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ----- Auth secrets (each at least 32 characters) -----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-0123456789
OTP_SECRET=change-me-to-another-long-random-string-0123456789
# Lower only for tests; 12 is the production value.
# BCRYPT_ROUNDS=12

# ----- Email (Brevo transactional API) -----
# Required in production. In development, leave BREVO_API_KEY empty to log OTPs.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VaranasiTrails
# Optional: where new enquiries are emailed.
ENQUIRY_NOTIFY_EMAIL=

# ----- Media (Cloudflare R2) -----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# Public bucket URL or custom domain, no trailing slash needed.
R2_PUBLIC_BASE_URL=https://media.example.com

# ----- Payments (reserved for later, optional) -----
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ----- Admin account (optional) -----
# When BOTH are set, the server creates/updates this admin on every start (idempotent).
# Changing ADMIN_PASSWORD rotates the password and signs the admin out everywhere.
# Password: 10+ characters with upper case, lower case and a number.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# ADMIN_PHONE=9999999999
