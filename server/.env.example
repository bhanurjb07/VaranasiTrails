# Copy to .env and fill in. No real secrets in this file.

# ----- Server -----
# Defaults to "production" when unset. Use "development" locally: OTP emails are
# then printed to the console when BREVO_API_KEY is missing.
NODE_ENV=development
PORT=5001
# Comma separated list of frontend origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

# ----- Database (Turso / libSQL) -----
# Local development: a SQLite file next to package.json.
DATABASE_URL=file:./dev.db
# Production: set these instead (the Turso values win when present).
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ----- Auth secrets (each at least 32 characters) -----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-0123456789
OTP_SECRET=change-me-to-another-long-random-string-0123456789
# Lower only for tests; 12 is the production value.
# BCRYPT_ROUNDS=12

# ----- Email (Brevo transactional API) -----
# Required in production. In development, leave BREVO_API_KEY empty to log OTPs.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VaranasiTrails
# Optional: where new enquiries are emailed.
ENQUIRY_NOTIFY_EMAIL=

# ----- Media (Cloudflare R2) -----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# Public bucket URL or custom domain, no trailing slash needed.
R2_PUBLIC_BASE_URL=https://media.example.com

# ----- Payments (reserved for later, optional) -----
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ----- Only read by `npm run seed:admin` (never by the server) -----
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# ADMIN_PHONE=9999999999
