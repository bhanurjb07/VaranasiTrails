# Copy to .env (next to docker-compose.yml). Everything here is optional.

# Admin account, created on start. Password: 10+ characters, upper and lower case, a number.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Site Admin

# Host ports
# SITE_PORT=8080
# ADMIN_PORT=8081
# API_PORT=5001

# Load the sample trips on start
# SEED_ON_START=true

# Cloudflare R2 (only needed for photo uploads and real image URLs)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://media.example.com
